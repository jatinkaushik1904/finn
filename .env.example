GEMINI_API_KEY=
GEMINI_FAST=gemini-3.1-flash-lite
GEMINI_SMART=gemini-3-flash-preview
ANTHROPIC_API_KEY=
CLAUDE_FAST=claude-haiku-5-5
CLAUDE_SMART=claude-sonnet-5-5
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# Closed-app alerts (Web Push). Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-deployment.example
# Where push subscriptions are kept on Vercel: a PRIVATE Blob store (vercel blob create-store ... --access private).
# Without it (local dev) they are kept in the OS temp dir.
BLOB_READ_WRITE_TOKEN=
# Optional: point FINN at a different NSE host (it moved from .com to .in in Nov 2026).
NSE_ORIGIN=
